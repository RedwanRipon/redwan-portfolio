# Copy this file to .env (gitignored) and fill in real values.

# Required — OpenAI API key for embeddings + LLM + TTS.
OPENAI_API_KEY=sk-...

# Model selection (defaults shown). Cheaper / faster:
#   LLM:        gpt-4o-mini
#   Embeddings: text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CORS — comma-separated origins allowed to call the API.
# Add your Vercel preview + production URLs here.
CORS_ORIGINS=http://localhost:3000,https://redwan-portfolio-2lrx.vercel.app

# Local paths (only override if you move things).
CHROMA_DIR=./data/chroma_db
SOURCES_DIR=./data/sources

# --- Database (Phase 4) ---
# Full SQLAlchemy URL.
#   Local dev (SQLite, no setup):  sqlite:///./local.db
#   Neon Postgres (production):    postgresql+psycopg://user:pwd@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./local.db

# --- Admin (Phase 4) ---
# Password to log into /admin on the live site. Pick something strong.
ADMIN_PASSWORD=change-this-to-something-strong
# Cookie-signing secret. Any random 32+ chars. Rotating invalidates sessions.
JWT_SECRET=change-this-to-32-chars-of-randomness
